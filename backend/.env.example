# Everything is optional — KisanSathi runs keyless by default.

# LLM provider: "ollama" (default, fully local) or "anthropic"
# KISANSATHI_LLM_PROVIDER=ollama
# KISANSATHI_OLLAMA_MODEL=qwen3:14b
# OLLAMA_BASE_URL=http://localhost:11434

# Only needed if provider=anthropic
# ANTHROPIC_API_KEY=
# KISANSATHI_ANTHROPIC_MODEL=claude-sonnet-5

# Free personal key from https://data.gov.in raises mandi-price rate limits
# DATA_GOV_IN_KEY=
